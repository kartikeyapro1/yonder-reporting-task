# ──────────────────────────────────────────────────────────────────────────────
# Yonder Reporting — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ──────────────────────────────────────────────────────────────────────────────

# Secret used to sign & verify magic link HMAC tokens.
# REQUIRED. Generate with:  openssl rand -base64 32
# NEVER reuse this between environments or share in plaintext.
PARTNER_LINK_SECRET=replace-me-generate-with-openssl-rand-base64-32

# Password for the internal Yonder dashboard (/internal-login).
# REQUIRED. No fallback — leaving this unset blocks all internal access.
# Keep out of Slack / email — share via 1Password or similar.
INTERNAL_SECRET=replace-me-generate-with-openssl-rand-base64-32

# Data source: "csv" (default for local dev) or "bigquery" (production)
DATA_SOURCE=csv

# BigQuery credentials (only required when DATA_SOURCE=bigquery)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

