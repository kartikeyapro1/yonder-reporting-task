# ──────────────────────────────────────────────────────────────────────────────
# Yonder Reporting — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ──────────────────────────────────────────────────────────────────────────────

# Secret used to sign & verify magic link HMAC tokens.
# Generate with:  openssl rand -base64 32
# NEVER reuse this between environments.
PARTNER_LINK_SECRET=replace-me-with-a-long-random-string

# Password for the internal Yonder dashboard (/internal-login).
# Keep this out of Slack / email — share via 1Password or similar.
INTERNAL_SECRET=yonder2025

# Data source: "csv" (default) or "bigquery"
DATA_SOURCE=csv

# BigQuery credentials (only required when DATA_SOURCE=bigquery)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
